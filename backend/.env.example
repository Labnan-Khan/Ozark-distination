NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/property_rental
MONGODB_DB=property_rental

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_MAX=10

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

STORAGE_PROVIDER=memory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=property-rental

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123456!
SEED_ADMIN_NAME=Platform Admin

DEFAULT_CURRENCY=PKR
MAX_IMAGES_PER_PROPERTY=10
MAX_ADVANCE_DAYS=365
LEAD_TIME_DAYS=0

WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=20

SCHEDULER_TICK_MS=60000
SCHEDULER_AVAILABILITY_INTERVAL_MS=3600000
SCHEDULER_SESSION_CLEANUP_INTERVAL_MS=86400000
SCHEDULER_MEDIA_CLEANUP_INTERVAL_MS=3600000
SCHEDULER_REMINDER_INTERVAL_MS=3600000
SCHEDULER_BATCH_SIZE=100
